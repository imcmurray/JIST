# GitLab Template Manager Configuration Example
# Copy this file to .env and update with your settings

# ==============================================================================
# SERVER SETTINGS
# ==============================================================================

# Server role: train, test, or live
# - train: Main development server with commit/push/promote capabilities
# - test: Staging server for testing changes
# - live: Production server
SERVER_ROLE=train

# Flask web server settings
FLASK_PORT=8080
FLASK_HOST=0.0.0.0          # 0.0.0.0 = all interfaces, 127.0.0.1 = localhost only
DEBUG=False                  # Set to True only for development

# ==============================================================================
# GITLAB SETTINGS
# ==============================================================================

# GitLab instance URL
# Examples:
#   - https://gitlab.com (GitLab.com)
#   - https://gitlab.example.com (Self-hosted)
GITLAB_URL=https://gitlab.com

# GitLab Personal Access Token
# Create at: Settings → Access Tokens
# Required scopes: api, read_repository, write_repository
# IMPORTANT: Keep this token secure!
GITLAB_TOKEN=your-gitlab-personal-access-token-here

# GitLab Project ID
# Find at: Project → Settings → General (under project name)
# Example: 12345
GITLAB_PROJECT_ID=your-project-id-here

# ==============================================================================
# REPOSITORY SETTINGS
# ==============================================================================

# Local path to the git repository containing templates
# This should be the directory where your templates are stored
# Example: /var/www/html/templates
REPO_PATH=/var/www/html/templates

# ==============================================================================
# BRANCH CONFIGURATION
# ==============================================================================

# Branch names in GitLab repository
# Default: train, test, live
# Change these if your repository uses different branch names
TRAIN_BRANCH=train
TEST_BRANCH=test
LIVE_BRANCH=live

# ==============================================================================
# AUTO-TERMINATION SETTINGS
# ==============================================================================

# Auto-terminate the web UI after period of inactivity (in seconds)
# Set to 0 to disable auto-termination
# Default: 3600 (1 hour)
AUTO_TERMINATE_TIMEOUT=3600

# ==============================================================================
# BACKUP SETTINGS
# ==============================================================================

# Enable automatic backups before pulling changes
# Recommended: True
BACKUP_ENABLED=True

# Directory where backups are stored
# Backups are named: template_backup_YYYYMMDD_HHMMSS
BACKUP_DIR=/var/backups/templates

# ==============================================================================
# GIT MANAGEMENT SETTINGS
# ==============================================================================

# Control whether Template Manager manages local git operations
# Set to False if an external application already manages the git repository
# When False:
#   - Local git operations (commit, push, pull) are disabled in UI
#   - Only GitLab API operations are available (promote, compare branches)
#   - Prevents conflicts with external git automation
# Default: True
MANAGE_LOCAL_GIT=True

# Use existing git remote configuration instead of setting up a new one
# Set to True if the repository already has the correct remote configured
# When True:
#   - Template Manager will not modify git remote settings
#   - Assumes remote is already pointing to the correct GitLab project
# Default: False
USE_EXISTING_REMOTE=False

# Verify that the git remote matches the configured GitLab project
# Recommended for safety to prevent accidental pushes to wrong repository
# When True:
#   - Checks that git remote URL matches GITLAB_PROJECT_ID
#   - Warns if mismatch detected
# Default: True
VERIFY_GIT_REMOTE=True

# ==============================================================================
# LOGGING SETTINGS
# ==============================================================================

# Log file location
# Make sure the directory exists and is writable
LOG_FILE=/var/log/template-manager.log

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# - DEBUG: Detailed information for diagnosing problems
# - INFO: General informational messages
# - WARNING: Warning messages (potential issues)
# - ERROR: Error messages (serious problems)
# Recommended: INFO
LOG_LEVEL=INFO

# ==============================================================================
# SECURITY SETTINGS
# ==============================================================================

# Flask secret key for session management
# Generate a random key: openssl rand -hex 32
# IMPORTANT: Change this in production!
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ==============================================================================
# EXAMPLE CONFIGURATIONS FOR DIFFERENT SERVERS
# ==============================================================================

# --- TRAIN SERVER EXAMPLE ---
# SERVER_ROLE=train
# GITLAB_URL=https://gitlab.example.com
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# GITLAB_PROJECT_ID=12345
# REPO_PATH=/var/www/html/templates

# --- TEST SERVER EXAMPLE ---
# SERVER_ROLE=test
# GITLAB_URL=https://gitlab.example.com
# GITLAB_TOKEN=glpat-yyyyyyyyyyyyyyyyyyyy
# GITLAB_PROJECT_ID=12345
# REPO_PATH=/var/www/html/templates

# --- LIVE SERVER EXAMPLE ---
# SERVER_ROLE=live
# GITLAB_URL=https://gitlab.example.com
# GITLAB_TOKEN=glpat-zzzzzzzzzzzzzzzzzzzz
# GITLAB_PROJECT_ID=12345
# REPO_PATH=/var/www/html/templates

# ==============================================================================
# NOTES
# ==============================================================================

# 1. Never commit the .env file to version control
# 2. Use different GitLab tokens for each server
# 3. Test server can use read-only token
# 4. Live server should use read-only token
# 5. Train server needs write access
# 6. Keep tokens secure and rotate them regularly
# 7. File permissions for .env should be 600 (readable only by owner)
